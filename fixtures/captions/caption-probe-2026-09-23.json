          "events": [
            "Dialogue: 0,0:00:01.09,0:00:02.83,Konosuba_Italics,Kazuma,0,0,0,,Some Divine Treasure this was.",
            "Dialogue: 0,0:00:04.69,0:00:07.78,Konosuba_Italics,Kazuma,0,0,0,,Who'd have thought it'd wear off so soon?",
            "Dialogue: 0,0:00:11.24,0:00:15.98,Konosuba_Main,Kazuma,0,0,0,,Eris-sama! I'm not into \\Nthis kind of teasing!",
            "Dialogue: 0,0:00:15.99,0:00:20.47,Konosuba_Ep_Title,Eptitle sign,0,0,0,,{\\fad(1,417)\\an3\\pos(610,315)\\3c&H0A0A0A&}Episode 6: {\\fsp1.2}A Farewell to This Lavish Lifestyle!",
            "Dialogue: 0,0:00:16.62,0:00:17.94,Konosuba_Main_Top,Aqua,0,0,0,,Hey, Kazuma.",
            "Dialogue: 0,0:00:17.63,0:00:18.90,Konosuba_Main_Top,Kazuma,0,0,0,,Yes, I'm Kazuma.",
            "Dialogue: 0,0:00:17.94,0:00:19.50,Konosuba_Main_Top,Aqua,0,0,0,,You love calling me an idiot,",
            "Dialogue: 0,0:00:19.50,0:00:21.86,Konosuba_Main_Top,Aqua,0,0,0,,but now I can be sure of something...",
            "Dialogue: 0,0:00:22.18,0:00:25.38,Konosuba_Main_Top,Aqua,0,0,0,,You're, like, an idiot of the \\Nhighest caliber, aren't you?",
            "Dialogue: 0,0:00:25.38,0:00:26.90,Konosuba_Main_Top,Kazuma,0,0,0,,It's not like that!"
          ]
        },
